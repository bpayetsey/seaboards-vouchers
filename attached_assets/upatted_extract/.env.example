# ── Replit: add these in the "Secrets" (lock icon) panel, not a file ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx          # optional in dev (confirm fallback works without it)

# SQLite lives in the repl — no external DB needed.
DATABASE_URL="file:./dev.db"

# Campaign settings
CURRENCY=eur                              # currency your Stripe account settles (SCR often unsupported)
INSTALMENTS=3
INTERVAL_DAYS=30
ISSUE_ON=paid                            # 'paid' (safer) or 'deposit' (issue after instalment 1)
ENABLE_INPROCESS_CRON=true               # convenience timer while the repl is awake
CRON_SECRET=change-me
